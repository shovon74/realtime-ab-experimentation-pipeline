# =============================================================================
# Real-Time Experimentation Event Pipeline - Configuration (.env.example)
# Copy to .env: cp .env.example .env
# =============================================================================

# --- Kafka (KRaft Mode) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_EXPOSURES=exposures
KAFKA_TOPIC_CONVERSIONS=conversions

# --- Synthetic Event Producer ---
PRODUCER_NUM_EXPERIMENTS=3
PRODUCER_VARIANTS_PER_EXP=2
PRODUCER_EVENT_RATE_PER_SEC=20
PRODUCER_TOTAL_USERS=10000
PRODUCER_RANDOM_SEED=42
# Data quality fault injection flags & rates
INJECT_DUPLICATE_EXPOSURES=true
DUPLICATE_EXPOSURE_RATE=0.02
INJECT_LATE_CONVERSIONS=true
LATE_CONVERSION_RATE=0.03
INJECT_ORPHAN_CONVERSIONS=true
ORPHAN_CONVERSION_RATE=0.01
INJECT_SRM_EXPERIMENT=true
SRM_EXPERIMENT_ID=checkout_flow_v2
SRM_CONTROL_SPLIT=0.55

# --- Spark Structured Streaming & Lake ---
SPARK_MASTER_URL=local[2]
LAKE_BASE_PATH=./lake
CHECKPOINT_BASE_PATH=./checkpoints
EXPOSURE_WATERMARK_MINUTES=10
CONVERSION_WATERMARK_MINUTES=30
ATTRIBUTION_WINDOW_HOURS=24
DEMO_ATTRIBUTION_WINDOW_MINUTES=30
MICROBATCH_TRIGGER_SECONDS=10
PARTITIONS_COALESCE=1
STREAM_OUTPUT_MODE=lake

# --- Warehouse Target (bigquery | postgres | snowflake) ---
WAREHOUSE_TYPE=bigquery
# BigQuery settings (used when WAREHOUSE_TYPE=bigquery)
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=experimentation_warehouse
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/gcp-credentials.json
# Local Postgres fallback / Metabase backing DB (used when WAREHOUSE_TYPE=postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=experimentation
POSTGRES_USER=exp_user
POSTGRES_PASSWORD=exp_pass

# --- Statistical Analysis ---
STATS_ALPHA=0.05
SRM_ALPHA=0.001

# --- Airflow & Alerting ---
AIRFLOW_UID=50000
ALERT_WEBHOOK_URL=
